+/* Resolve genuine user32 exports without cnc-ddraw's GetProcAddress remapping. */
+void *goc_real_user32(const char *name) {
+    typedef struct { USHORT Length, MaximumLength; char *Buffer; } NativeAnsi;
+    typedef LONG (WINAPI *Resolve)(HMODULE, NativeAnsi *, ULONG, void **);
+    Resolve resolve=(Resolve)GetProcAddress(GetModuleHandleA("ntdll.dll"),"LdrGetProcedureAddress");
+    NativeAnsi a={(USHORT)strlen(name),(USHORT)(strlen(name)+1),(char *)name};
+    void *p=NULL;
+    if(resolve) resolve(GetModuleHandleA("user32.dll"),&a,0,&p);
+    return p;
+}
